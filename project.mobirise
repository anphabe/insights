                  ".item-content": {
                    "padding": "2rem 2rem 0"
                  },
                  ".item-footer": {
                    "padding": "0 2rem 2rem"
                  }
                },
                "& when not (@showButtons)": {
                  ".item-content": {
                    "padding": "2rem"
                  }
                }
              },
              "@media (max-width: 991px)": {
                "& when (@showButtons)": {
                  ".item-content": {
                    "padding": "1rem 1rem 0"
                  },
                  ".item-footer": {
                    "padding": "0 1rem 1rem"
                  }
                },
                "& when not (@showButtons)": {
                  ".item-content": {
                    "padding": "1rem"
                  }
                }
              }
            },
            ".mbr-section-btn": {
              "margin-top": "auto !important"
            },
            ".mbr-section-title": {
              "color": "#232323"
            },
            ".mbr-text, .mbr-section-btn": {
              "text-align": "center"
            },
            ".item-title": {
              "text-align": "center"
            },
            ".item-subtitle": {
              "text-align": "left"
            },
            ".item-wrapper-blue": {
              "border": "4px solid #0a75ba"
            },
            ".item-wrapper-green": {
              "border": "4px solid #56a86b"
            },
            ".item-wrapper-red": {
              "border": "4px solid #9e2216"
            },
            ".btn-secondary-outline, .btn-secondary-outline:active, .btn-secondary-outline:hover, .btn-secondary-outline:link": {
              "border": "2px solid #fb596d!important",
              "padding-left": "2rem",
              "padding-right": "2rem"
            },
            ".btn-secondary-outline:hover": {
              "background-color": "#fb596d!important",
              "color": "#fff!important",
              "padding-left": "2rem",
              "padding-right": "2rem"
            },
            ".mbr-section-subtitle": {
              "color": "#232323"
            },
            "@media (max-width: 768px)": {
              "padding-top": "(@paddingTop * 0.5rem)",
              "padding-bottom": "(@paddingBottom * 0.5rem)",
              ".item": {
                "margin-bottom": "1rem"
              }
            }
